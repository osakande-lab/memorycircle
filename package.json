    "test": "node --test tests/*.test.js",
    "spike": "node scripts/spike.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "ffmpeg-static": "^5.0.0",
    "supertest": "^7.0.0",
    "vite": "^7.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}